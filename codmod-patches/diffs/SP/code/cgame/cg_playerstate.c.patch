diff --git a/SP/code/cgame/cg_playerstate.c b/SP/code/cgame/cg_playerstate.c
index d60519b2..6107d3ed 100644
--- a/SP/code/cgame/cg_playerstate.c
+++ b/SP/code/cgame/cg_playerstate.c
@@ -387,7 +387,12 @@ void CG_CheckLocalSounds( playerState_t *ps, playerState_t *ops ) {
 
 	// hit changes
 	if ( ps->persistant[PERS_HITS] > ops->persistant[PERS_HITS] ) {
-		trap_S_StartLocalSound( cgs.media.hitSound, CHAN_LOCAL_SOUND );
+		// codmod: E9 CoD hit markers (X + body/headshot tick). Fall back to vanilla beep.
+		if ( bg_cod.enable && bg_cod.hitMarkerEnable ) {
+			CG_CodCheckHitMarker( ps, ops );
+		} else {
+			trap_S_StartLocalSound( cgs.media.hitSound, CHAN_LOCAL_SOUND );
+		}
 	} else if ( ps->persistant[PERS_HITS] < ops->persistant[PERS_HITS] ) {
 		trap_S_StartLocalSound( cgs.media.hitTeamSound, CHAN_LOCAL_SOUND );
 	}
@@ -548,6 +553,23 @@ void CG_TransitionPlayerState( playerState_t *ps, playerState_t *ops ) {
 	if ( ps->viewheight != ops->viewheight ) {
 		cg.duckChange = ps->viewheight - ops->viewheight;
 		cg.duckTime = cg.time;
+		// codmod: prone transitions use proneDown/UpTime; crouch keeps duckTime (phase 6b)
+		if ( bg_cod.enable && bg_cod.proneEnable
+			 && ( ops->viewheight == (int)bg_cod.proneViewHeight
+				  || ps->viewheight == (int)bg_cod.proneViewHeight ) ) {
+			if ( ps->viewheight < ops->viewheight ) {
+				cg.codDuckDuration = (int)bg_cod.proneDownTime;
+			} else {
+				cg.codDuckDuration = (int)bg_cod.proneUpTime;
+			}
+		} else if ( bg_cod.enable ) {
+			cg.codDuckDuration = (int)bg_cod.duckTime;
+		} else {
+			cg.codDuckDuration = DUCK_TIME;
+		}
+		if ( cg.codDuckDuration < 1 ) {
+			cg.codDuckDuration = 1;
+		}
 	}
 }
 
