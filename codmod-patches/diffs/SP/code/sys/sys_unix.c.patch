+/*
+================
+Sys_WaitUntil
+
+Hybrid sleep + spin until the monotonic deadline (Sys_Microseconds time base).
+spinUs < 0: adaptive margin from recent sleep overshoot; 0: sleep only; >0: fixed.
+Returns how many microseconds past the deadline we woke (0 if on time).
+================
+*/
+long long Sys_WaitUntil( long long deadlineUs, int spinUs )
+{
+	static int  autoSpin = 300;     // adaptive spin margin (us)
+	static int  worstRing[32], ringPos;
+	static qboolean slackSet;
+	long long   now, wake;
+	int         margin, i, worst;
+	struct timespec ts;
+
+	if ( !slackSet ) {
+#ifdef __linux__
+		prctl( PR_SET_TIMERSLACK, 1UL, 0, 0, 0 );
+#endif
+		slackSet = qtrue;
+	}
+
+	margin = ( spinUs < 0 ) ? autoSpin : spinUs;
+
+	now = Sys_Microseconds();
+	wake = deadlineUs - margin;
+	if ( wake > now ) {
+		ts.tv_sec = wake / 1000000LL;
+		ts.tv_nsec = ( wake % 1000000LL ) * 1000;
+		while ( clock_nanosleep( CLOCK_MONOTONIC, TIMER_ABSTIME, &ts, NULL ) == EINTR ) {
+		}
+		if ( spinUs < 0 ) {
+			// how late did the sleep wake us relative to the requested wake time?
+			int over = (int)( Sys_Microseconds() - wake );
+			worstRing[ringPos++ & 31] = over < 0 ? 0 : over;
+			for ( worst = 0, i = 0; i < 32; i++ ) {
+				if ( worstRing[i] > worst ) {
+					worst = worstRing[i];
+				}
+			}
+			autoSpin = worst + 100;
+			if ( autoSpin > 2000 ) {
+				autoSpin = 2000;
+			}
+		}
+	}
+
+	while ( ( now = Sys_Microseconds() ) < deadlineUs ) {
+#if defined( __x86_64__ ) || defined( __i386__ )
+		__builtin_ia32_pause();
+#endif
+	}
+	return now - deadlineUs;
+}
